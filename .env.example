# Copy to .env for `netlify dev`. In production set these in Netlify > Site > Environment variables.
SITE_URL=https://sanaessencia.co.uk
BR_SITE_URL=https://sanaessencia.com.br
ALLOWED_ORIGINS=https://sanaessencia.co.uk,https://sanaessencia.com.br
# Long random string (openssl rand -base64 48). Signs sign-in sessions and entitlement tokens.
SESSION_SECRET=change-me-to-a-long-random-string
# Patricia's admin key for manual grants (gift plans, founding testers).
ADMIN_KEY=change-me
# Email: Resend (https://resend.com). Leave empty locally: links are printed to the console instead.
RESEND_API_KEY=
# Local only: print sign-in links to the console instead of emailing them. Never set on Netlify.
# ALLOW_DEV_EMAIL=1
EMAIL_FROM=Sana Essencia <hello@sanaessencia.co.uk>
# Where replies to the sign-in email go. Optional. Resend's reply_to.
EMAIL_REPLY_TO=hello@sanaessencia.co.uk
# Payhip: Settings > Developer > API key (used to check webhook signatures).
PAYHIP_API_KEY=
# Secret added to webhook URLs, e.g. https://sanaessencia.co.uk/api/webhooks/payhip?k=THIS
WEBHOOK_URL_KEY=change-me
# Payhip products. Key = product link code (payhip.com/b/<code>). secret = product secret key (for licence checks).
PAYHIP_PRODUCTS={"bT6IA":{"plan":"maker","days":365,"secret":""},"e2aDO":{"plan":"studio","days":365,"secret":""},"W5V4U":{"plan":"studio","days":365,"secret":""}}
# Add a monthly Payhip membership here once created, e.g. "XXXXX":{"plan":"maker","subscription":true,"days":31}
# Hotmart: Ferramentas > Webhook > hottok, and product id -> plan.
HOTMART_HOTTOK=
HOTMART_PRODUCTS={"0000000":{"plan":"maker","days":365}}
# Google Play (Phase 3). Service account JSON with access to the Play Console app.
PLAY_PACKAGE_NAME=uk.co.sanaessencia.blendstudio
PLAY_PRODUCTS={"maker_monthly":{"plan":"maker"}}
GOOGLE_SERVICE_ACCOUNT_JSON=
